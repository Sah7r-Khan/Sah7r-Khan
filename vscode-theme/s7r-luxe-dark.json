  "tokenColors": [
    {
      "scope": ["comment"],
      "settings": {
        "foreground": "#7A6A85",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string"],
      "settings": {
        "foreground": "#FECA57"
      }
    },
    {
      "scope": ["constant.numeric", "constant.language"],
      "settings": {
        "foreground": "#D946EF"
      }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#E91E8C"
      }
    },
    {
      "scope": ["entity.name.function", "support.function"],
      "settings": {
        "foreground": "#B565FF"
      }
    },
    {
      "scope": ["entity.name.class", "entity.name.type"],
      "settings": {
        "foreground": "#F41A95"
      }
    },
    {
      "scope": ["variable", "variable.parameter"],
      "settings": {
        "foreground": "#F0E8F8"
      }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": {
        "foreground": "#9D2FE8"
      }
    },
    {
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#F8F4FC",
        "fontStyle": "bold"
      }
    },
    {
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#E8DCF5",
        "fontStyle": "italic"
      }
    }
  ]
